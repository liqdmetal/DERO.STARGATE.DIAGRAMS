<mxfile host="app.diagrams.net" modified="2026-08-25T13:43:15.000Z" agent="Hermes-AI" version="24.4.8" type="device" background="#F4F7FC">
  <diagram id="runbook" name="Node Operator Runbook">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#F4F7FC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEC;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#B91C1C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="NODE OPERATOR RUNBOOK" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#1C2A3A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="From download to a healthy, updated full node.  Each step is a box — follow top to bottom." style="text;html=1;align=center;fontSize=13;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="b-2" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;1 · Download&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;official release (DEROFDN/derohe) · verify sha512 + GPG signature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#2563EB;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;2 · Configure&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;--p2p-bind=0.0.0.0:10101 (pin it) · keep RPC 10102 local&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#2563EB;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="208" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;font color=&quot;#0D9488&quot;&gt;&lt;b&gt;3 · Sync&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;start derod · fast-sync with a recent snapshot · watch status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#0D9488;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="286" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;font color=&quot;#10B981&quot;&gt;&lt;b&gt;4 · Serve&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;open only the P2P port in the firewall · never expose RPC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;font color=&quot;#10B981&quot;&gt;&lt;b&gt;5 · Monitor&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;derod status · chain height · peer count · disk usage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="442" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;font color=&quot;#F59E0B&quot;&gt;&lt;b&gt;6 · Update&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;new release → stop → backup data-dir → swap binary → restart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#F59E0B;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;7 · Hard-Fork readiness&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;HF3 activated at block 7,504,640 — run Release153+ to stay in sync (Release153 fixed false-parity sync)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="598" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;8 · Troubleshoot&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;clock drift → install chrony · MBR rising → check miner + time sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="676" width="1560" height="62" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;9 · Backup&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;data-dir copy off-host · wallet seeds separate from node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="754" width="1560" height="62" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="xswd" name="XSWD Permission Model">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#F4F7FC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEC;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#B91C1C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="XSWD — HOW dApps TALK TO YOUR WALLET" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#1C2A3A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="Decentralized web apps get NO direct access to your keys — every interaction is a permissioned request through the wallet." style="text;html=1;align=center;fontSize=13;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="b-2" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;dApp / TELA page&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;wants to read balance, sign a tx, or call a smart contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="340" height="90" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;font color=&quot;#0D9488&quot;&gt;&lt;b&gt;XSWD bridge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;WebSocket · routes the request to your wallet · nothing else&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#0D9488;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="340" height="90" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;font color=&quot;#10B981&quot;&gt;&lt;b&gt;Your wallet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;pops up a permission request — YOU decide&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1320" y="140" width="340" height="90" as="geometry"/></mxCell><mxCell id="x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2563EB;strokeWidth=2.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="185" as="sourcePoint"/><mxPoint x="720" y="185" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="x1-l" value="ask" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2563EB;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2563EB;strokeWidth=2.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="185" as="sourcePoint"/><mxPoint x="1320" y="185" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="x2-l" value="request" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2563EB;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="b-7" value="&lt;font color=&quot;#F59E0B&quot;&gt;&lt;b&gt;You choose per request:  ASK  ·  ACCEPT ALWAYS  ·  DENY ALWAYS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;never hand a dApp ‘accept always’ you don’t trust&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#F59E0B;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="320" width="1560" height="50" as="geometry"/></mxCell><mxCell id="t-8" value="WHAT XSWD CAN EXPOSE (methods you approve one by one)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#2563EB;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="410" width="900" height="20" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;get_info / get_balance&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;read balances &amp; chain info&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#2563EB;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="452" width="780" height="54" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;transfer / sc_invoke&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;sign a transfer or smart-contract call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#2563EB;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="522" width="780" height="54" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;install_sc&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;deploy a new smart contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#2563EB;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="592" width="780" height="54" as="geometry"/></mxCell><mxCell id="b-12" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;register_address / name service&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;manage your DERO identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#2563EB;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="662" width="780" height="54" as="geometry"/></mxCell><mxCell id="t-13" value="SECURITY RULES" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#DC2626;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="980" y="410" width="700" height="20" as="geometry"/></mxCell><mxCell id="b-14" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Only approve what you’re using&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;a dApp can only do what you allow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="980" y="452" width="700" height="54" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Prefer ASK over ACCEPT ALWAYS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;one-time approval, not standing access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="980" y="522" width="700" height="54" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Check the method + SCID&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;make sure it’s the contract you expect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="980" y="592" width="700" height="54" as="geometry"/></mxCell><mxCell id="b-17" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Revoke when done&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;most wallets let you clear permissions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="980" y="662" width="700" height="54" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="dvm" name="DVM-BASIC Cheat-Sheet">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#F4F7FC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEC;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#B91C1C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="DVM-BASIC — SMART-CONTRACT CHEAT-SHEET" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#1C2A3A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="The essentials to read or write a DERO contract.  DRAFT — verify against the DVM docs before shipping anything." style="text;html=1;align=center;fontSize=13;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="b-2" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;install_sc → SCID&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;deploy a contract, get its address (SCID)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;RETURN 0 = success&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;state commits only on 0 · nonzero rolls back&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;IF … THEN GOTO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;control flow — no else, no loops, just gotos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;STORE / LOAD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;persist and read contract state (private)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="460" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;SIGNED_BY_ENTRYPOINT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;require a valid signature to call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;block_height&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;timelock a tx until a future block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;SEND_DERO_TO_ADDRESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;move DERO from the contract — compressed key bytes, not bech32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;font color=&quot;#8B5CF6&quot;&gt;&lt;b&gt;rpc.Argument&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;uint64 literals need an explicit uint64() cast&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="800" height="90" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;font color=&quot;#F59E0B&quot;&gt;&lt;b&gt;GAS &amp; LIMITS — mainnet (Release153): 10M compute gas/call · line 5k · expr 800 · store 10k · ≈1.7k statements/call&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;verified dvm/sc.go:238 GasComputeLimit=10,000,000 · dvm.go:522/994 · dvm_functions.go (DRAFT: verify on next release)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#F59E0B;strokeWidth=1.4;fontSize=13;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="1560" height="56" as="geometry"/></mxCell><mxCell id="dvm-ex" value="Function Initialize() Uint64
  10 STORE(&quot;owner&quot;, SIGNER())
  20 RETURN 0
Function Ping() Uint64
  10 IF SIGNED_BY_ENTRYPOINT() == 0 THEN GOTO 40
  20 STORE(&quot;last&quot;, block_height)
  30 RETURN 0
  40 RETURN 1  — rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=11;fontColor=#1C2A3A;align=left;verticalAlign=middle;spacing=10;fontFamily=Consolas;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="680" width="1560" height="170" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="bridges" name="Bridges &amp; Interop">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#F4F7FC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEC;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#B91C1C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="BRIDGES &amp; INTEROP — HONEST MAP" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#1C2A3A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="How DERO connects to other chains — and where the risk is.  Bridges are the #1 place people lose money: trust matters." style="text;html=1;align=center;fontSize=13;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="t-2" value="LIVE / PARTIAL TODAY" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#10B981;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="700" height="20" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;font color=&quot;#10B981&quot;&gt;&lt;b&gt;ETH ↔ DERO bridge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;lock ETH → mint wrapped on DERO · burn to unlock · trust the bridge operators/audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="1560" height="76" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;font color=&quot;#10B981&quot;&gt;&lt;b&gt;cldex / dero_swap&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;on-DERO decentralized exchange — swap DERO tokens &amp; wrapped assets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="262" width="1560" height="76" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;font color=&quot;#10B981&quot;&gt;&lt;b&gt;Artificer / ERC-20s&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;tokens &amp; NFTs issued directly on DERO (NFA, Seals, Deroscapes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#10B981;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="358" width="1560" height="76" as="geometry"/></mxCell><mxCell id="t-6" value="WHERE THE RISK LIVES" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#DC2626;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="700" height="20" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Trust assumption&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;every bridge is a custodian at some layer — if it gets hacked, funds go with it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="516" width="1560" height="76" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Phishing surface&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;fake bridge sites / fake wrapped-token addresses are common scams&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="612" width="1560" height="76" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Interop limits&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;not everything is bridgeable — check the bridge’s supported assets before sending&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#DC2626;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="708" width="1560" height="76" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;font color=&quot;#F59E0B&quot;&gt;&lt;b&gt;GOOD PRACTICE: verify the official bridge contract/SCID from the project’s docs · send a tiny test amount first · never click “bridge” links from DMs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;bridges concentrate value — that’s where attackers aim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F7FAFF;gradientDirection=south;strokeColor=#F59E0B;strokeWidth=1.4;fontSize=12.5;fontColor=#1C2A3A;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="830" width="1560" height="60" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
