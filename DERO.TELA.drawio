<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-25T13:35:00.000Z" agent="Hermes-AI" version="24.4.8" type="device">
  <diagram id="tela" name="From Idea to On-Chain App">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="1354" width="400" height="34" as="geometry"/></mxCell><mxCell id="t-t1" value="FROM IDEA TO ON-CHAIN APP" style="text;html=1;align=center;fontSize=30;fontStyle=1;fontColor=#38BDF8;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="t-t2" value="Build a dApp on DERO: DVM smart contract + TELA front-end + XSWD wallet bridge — no server, no middleman, full privacy.  · read 1 → 6" style="text;html=1;align=center;fontSize=14;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="t-s0" value="&lt;font color=&quot;#38BDF8&quot;&gt;&lt;b&gt;1 · WRITE THE CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Smart contract in DVM-BASIC (DeroScript) + the app front-end (HTML/CSS/JS). dSlate&lt;br&gt;gives a visual editor; the VSCode extension adds syntax highlighting.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 You write normal-looking code — the backend is the whole network.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=11;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="540" height="380" as="geometry"/></mxCell><mxCell id="t-bd0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#38BDF8;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="43" y="133" width="34" height="34" as="geometry"/></mxCell><mxCell id="t-s1" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;2 · DEPLOY (install_sc)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Send the code to the chain via RPC (install_sc) and get back an SCID. The contract&lt;br&gt;now runs on every node. One-time fee — no hosting bill.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your program moves into a building everyone owns and nobody controls.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#2DD4BF;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=11;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="540" height="380" as="geometry"/></mxCell><mxCell id="t-bd1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2DD4BF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="683" y="133" width="34" height="34" as="geometry"/></mxCell><mxCell id="t-s2" value="&lt;font color=&quot;#A78BFA&quot;&gt;&lt;b&gt;3 · CONNECT THE WALLET (XSWD)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;The app talks to the user’s wallet over a WebSocket bridge. The user grants&lt;br&gt;per-request permissions: ask / accept_always / deny_always.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The app can’t touch your money unless you approve — per request.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#A78BFA;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=11;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="1340" y="150" width="540" height="380" as="geometry"/></mxCell><mxCell id="t-bd2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#A78BFA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1323" y="133" width="34" height="34" as="geometry"/></mxCell><mxCell id="t-s3" value="&lt;font color=&quot;#34D399&quot;&gt;&lt;b&gt;4 · USERS SIGN IN &amp; PAY (DeroAuth / DeroPay)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Users log in with their wallet — no passwords — and pay in DERO, all inside the&lt;br&gt;wallet (Engram). Payments and identity stay private.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Signing in = approving with your wallet.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#34D399;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=11;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="540" height="380" as="geometry"/></mxCell><mxCell id="t-bd3" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#34D399;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="43" y="623" width="34" height="34" as="geometry"/></mxCell><mxCell id="t-s4" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;5 · TELA SERVES IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;App code and assets are stored on-chain and rendered locally in Engram (wallet +&lt;br&gt;browser). No origin server to hack, block, or censor.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your shop is on everyone’s land — and nobody owns it.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#2DD4BF;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=11;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="540" height="380" as="geometry"/></mxCell><mxCell id="t-bd4" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2DD4BF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="683" y="623" width="34" height="34" as="geometry"/></mxCell><mxCell id="t-s5" value="&lt;font color=&quot;#FB923C&quot;&gt;&lt;b&gt;6 · ITERATE &amp; GROW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;New versions are registered on-chain; state stays encrypted (private DVM state);&lt;br&gt;Gnomon indexes chain data for analytics.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Software that can’t be yanked away — upgradeable, private, unstoppable.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#FB923C;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=11;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="1340" y="640" width="540" height="380" as="geometry"/></mxCell><mxCell id="t-bd5" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FB923C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1323" y="623" width="34" height="34" as="geometry"/></mxCell><mxCell id="t-a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2.5;fontSize=10.5;fontStyle=1;fontColor=#0076BE;labelBackgroundColor=#141E36;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="340" as="sourcePoint"/><mxPoint x="700" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2.5;fontSize=10.5;fontStyle=1;fontColor=#0076BE;labelBackgroundColor=#141E36;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="340" as="sourcePoint"/><mxPoint x="1340" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-a3" value="deployed &amp; live" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2.5;fontSize=10.5;fontStyle=1;fontColor=#0076BE;labelBackgroundColor=#141E36;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="530" as="sourcePoint"/><mxPoint x="1610" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2.5;fontSize=10.5;fontStyle=1;fontColor=#0076BE;labelBackgroundColor=#141E36;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="700" as="sourcePoint"/><mxPoint x="330" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2.5;fontSize=10.5;fontStyle=1;fontColor=#0076BE;labelBackgroundColor=#141E36;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="700" as="sourcePoint"/><mxPoint x="970" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-a6" value="users in the wallet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2.5;fontSize=10.5;fontStyle=1;fontColor=#0076BE;labelBackgroundColor=#141E36;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="1020" as="sourcePoint"/><mxPoint x="1610" y="1090" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-f1" value="THE RESULT" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#38BDF8;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="260" height="22" as="geometry"/></mxCell><mxCell id="t-f2" value="A web app that cannot be taken down, whose users log in with their wallet, whose data is encrypted — hosted by the network itself. That is TELA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=13.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1830" height="96" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="stack" name="The dApp Stack">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="876" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="830" width="400" height="34" as="geometry"/></mxCell><mxCell id="st-t" value="THE DAPP STACK" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#38BDF8;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="40" as="geometry"/></mxCell><mxCell id="st-s" value="Each layer of the DERO stack — from the encrypted ledger up to the user’s wallet." style="text;html=1;align=center;fontSize=13.5;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="st-h1" value="LAYER" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#38BDF8;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="320" height="30" as="geometry"/></mxCell><mxCell id="st-h2" value="WHAT IT IS" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#38BDF8;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="620" height="30" as="geometry"/></mxCell><mxCell id="st-h3" value="WHAT IT DOES" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#38BDF8;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="820" height="30" as="geometry"/></mxCell><mxCell id="st-r0c0" value="DHEBP · Layer 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="148" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r0c1" value="encrypted ledger + consensus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="148" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r0c2" value="privacy, settlement, security — 18 s blocks, PoW AstroBWTv3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="148" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r1c0" value="DVM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r1c1" value="smart-contract VM (DVM-BASIC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r1c2" value="business logic runs on every node, state encrypted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r2c0" value="GravitonDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r2c1" value="encrypted key/value state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="292" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r2c2" value="66 B per account · merkle-proved · prunable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="292" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r3c0" value="TELA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="364" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r3c1" value="on-chain decentralized web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="364" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r3c2" value="HTML/CSS/JS stored in contracts, served by the network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="364" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r4c0" value="XSWD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r4c1" value="app ↔ wallet WebSocket bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="436" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r4c2" value="per-request permissions: ask / accept_always / deny_always" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="436" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r5c0" value="Engram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="508" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r5c1" value="smart wallet + browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="508" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r5c2" value="users’ window into dApps, TELA sites, and identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="508" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r6c0" value="DeroAuth / DeroPay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r6c1" value="sign in &amp; pay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r6c2" value="passwordless login, wallet-native payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="580" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r7c0" value="Name Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="652" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r7c1" value="human-readable names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="652" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r7c2" value="wallet addresses you can actually read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="652" width="820" height="64" as="geometry"/></mxCell><mxCell id="st-r8c0" value="Gnomon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2DD4BF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="724" width="320" height="64" as="geometry"/></mxCell><mxCell id="st-r8c1" value="chain indexer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#26334D;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="724" width="620" height="64" as="geometry"/></mxCell><mxCell id="st-r8c2" value="query chain data and smart-contract state locally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="724" width="820" height="64" as="geometry"/></mxCell></root></mxGraphModel>
