  <diagram id="begin" name="Where Do I Begin">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="WHERE DO I BEGIN?" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="One entry point → branch to the right diagram.  Everything else in this set is a deep dive." style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="p1-start" value="I want to use DERO" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="220" height="60" as="geometry"/></mxCell><mxCell id="p1-b0" value="Pay or receive money" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=14;fontStyle=1;fontColor=#34D399;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="300" height="64" as="geometry"/></mxCell><mxCell id="p1-d0" value="Journey diagram → then the Wallet guide (p2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidt