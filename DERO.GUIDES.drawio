  <diagram id="security" name="Self-Custody Security">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="SELF-CUSTODY SECURITY POSTER" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="DERO has NO recovery service — if you lose the seed or wallet password, the coins are gone forever.  This page is the difference between safe and sorry." style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="p3-do" value="DO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34D399;strokeColor=none;fontSize=18;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="220" height="46" as="geometry"/></mxCell><mxCell id="p3-do0" value="Write the seed on paper, offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-do0d" value="never on a connected device" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="224" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-do1" value="Store 2-3 copies in separate places" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="290" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-do1d" value="fire/flood/theft safe" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="324" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-do2" value="Test restoring from the seed once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="390" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-do2d" value="before putting real funds in" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="424" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-do3" value="Use a strong wallet password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="490" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-do3d" value="that you also can’t forget" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="524" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-do4" value="Keep node + wallet on up-to-date releases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-do4d" value="and verify checksums / GPG" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="624" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-dont" value="DON’T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F87171;strokeColor=none;fontSize=18;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="220" height="46" as="geometry"/></mxCell><mxCell id="p3-dont0" value="Never type your seed into a website" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#F87171;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-dont0d" value="including “verification” sites" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="224" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-dont1" value="Never screenshot or cloud-store it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#F87171;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-dont1d" value="photos sync = exposure" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="324" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-dont2" value="Never share it — support never asks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#F87171;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="390" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-dont2d" value="support has no seed access" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="424" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-dont3" value="Don’t put big funds on a hot wallet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#F87171;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-dont3d" value="use cold/offline storage" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="524" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-dont4" value="Don’t trust third-party “custody”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.4;fontSize=13.5;fontStyle=1;fontColor=#F87171;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="590" width="740" height="66" as="geometry"/></mxCell><mxCell id="p3-dont4d" value="only you should hold keys" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="624" width="700" height="30" as="geometry"/></mxCell><mxCell id="p3-t" value="The threat model in one line" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#FBBF24;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="300" height="20" as="geometry"/></mxCell><mxCell id="p3-t0" value="Phishing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=13;fontStyle=1;fontColor=#FBBF24;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="748" width="360" height="56" as="geometry"/></mxCell><mxCell id="p3-t0d" value="fake wallet sites &amp; “support” asking for seed" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="808" width="360" height="40" as="geometry"/></mxCell><mxCell id="p3-t1" value="Malware / keyloggers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=13;fontStyle=1;fontColor=#FBBF24;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="520" y="748" width="360" height="56" as="geometry"/></mxCell><mxCell id="p3-t1d" value="keep your OS clean, verify downloads" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="808" width="360" height="40" as="geometry"/></mxCell><mxCell id="p3-t2" value="Seed loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=13;fontStyle=1;fontColor=#FBBF24;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="920" y="748" width="360" height="56" as="geometry"/></mxCell><mxCell id="p3-t2d" value="paper, metal, multiple copies — no recovery" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="920" y="808" width="360" height="40" as="geometry"/></mxCell><mxCell id="p3-t3" value="Custodian failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=13;fontStyle=1;fontColor=#FBBF24;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="1320" y="748" width="360" height="56" as="geometry"/></mxCell><mxCell id="p3-t3d" value="exchange hacks — self-custody avoids this" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1320" y="808" width="360" height="40" as="geometry"/></mxCell></root></mxGraphModel>
