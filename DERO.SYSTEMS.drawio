icalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="s2-l4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#FB8C00;strokeWidth=2.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="480" as="sourcePoint"/><mxPoint x="1740" y="470" as="targetPoint"/></mxGeometry><mxCell id="s2-l4-l" value="GETWORK · 10100" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#FB8C00;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="s2-l5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#8E24AA;strokeWidth=2.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="770" as="sourcePoint"/><mxPoint x="760" y="420" as="targetPoint"/></mxGeometry><mxCell id="s2-l5-l" value="read RPC · 10102" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#8E24AA;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="s2-l6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#00838F;strokeWidth=2.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="770" as="sourcePoint"/><mxPoint x="1740" y="420" as="targetPoint"/></mxGeometry><mxCell id="s2-l6-l" value="XSWD ↔ wallet" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#00838F;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="s2-sec" value="🛡️ SECURITY RULES" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="300" height="22" as="geometry"/></mxCell><mxCell id="s2-secb" value="Never expose the RPC port (10102) to the internet — local only · P2P port is randomized; pin it and open it in the firewall if you want inbound peers · wallet keys never leave the wallet process · use a VPN/SSH tunnel for remote RPC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="928" width="900" height="120" as="geometry"/></mxCell><mxCell id="s2-ph" value="PORT REFERENCE" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="1000" y="900" width="300" height="22" as="geometry"/></mxCell><mxCell id="s2-pt-P2P" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;P2P&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;10101&lt;/font&gt; — &lt;font color=&quot;#66727E&quot;&gt;node ↔ node gossip + sync&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8A97A3&quot;&gt;&lt;i&gt;randomized at startup · pin with --p2p-bind&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="930" width="880" height="56" as="geometry"/></mxCell><mxCell id="s2-pt-GETWORK" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;GETWORK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;10100&lt;/font&gt; — &lt;font color=&quot;#66727E&quot;&gt;miner ↔ daemon work&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8A97A3&quot;&gt;&lt;i&gt;only if miners connect from outside&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="994" width="880" height="56" as="geometry"/></mxCell><mxCell id="s2-pt-RPC (daemon)" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;RPC (daemon)&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;10102&lt;/font&gt; — &lt;font color=&quot;#66727E&quot;&gt;daemon JSON-RPC API&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8A97A3&quot;&gt;&lt;i&gt;keep local (127.0.0.1) — never expose&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="1058" width="880" height="56" as="geometry"/></mxCell><mxCell id="s2-pt-Wallet RPC" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;Wallet RPC&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;10103&lt;/font&gt; — &lt;font color=&quot;#66727E&quot;&gt;wallet API for CLI/Engram&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8A97A3&quot;&gt;&lt;i&gt;local only · keys never leave wallet&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="1122" width="880" height="56" as="geometry"/></mxCell><mxCell id="s2-pt-XSWD" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;XSWD&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;via wallet&lt;/font&gt; — &lt;font color=&quot;#66727E&quot;&gt;dApp ↔ wallet WebSocket&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8A97A3&quot;&gt;&lt;i&gt;per-request ask / accept / deny&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="1186" width="880" height="56" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="stack" name="Protocol Stack">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1226" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="1182" width="380" height="34" as="geometry"/></mxCell><mxCell id="s3t" value="DERO SYSTEMS REFERENCE — THE PROTOCOL STACK" style="text;html=1;align=center;fontSize=30;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="s3s" value="Six layers, bottom = the math, top = what users touch.  Each layer only trusts the one beneath it." style="text;html=1;align=center;fontSize=13.5;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="s3-APPLICATIONS" value="APPLICATIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00838F;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="s3-APPLICATIONS-b" value="Wallets (Engram, CLI, g45w)&lt;br&gt;TELA · on-chain web&lt;br&gt;DeroAuth / DeroPay&lt;br&gt;DeroBeats · dReams · Hologram · cldex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=2;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="1480" height="150" as="geometry"/></mxCell><mxCell id="s3-APPLICATIONS-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#4277BB;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="195" as="sourcePoint"/><mxPoint x="380" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-INTERFACES" value="INTERFACES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="300" height="150" as="geometry"/></mxCell><mxCell id="s3-INTERFACES-b" value="JSON-RPC (daemon 10102 / wallet 10103)&lt;br&gt;GETWORK websocket (10100)&lt;br&gt;XSWD — dApp ↔ wallet bridge&lt;br&gt;MCP server — AI read access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="286" width="1480" height="150" as="geometry"/></mxCell><mxCell id="s3-INTERFACES-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#4277BB;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="361" as="sourcePoint"/><mxPoint x="380" y="361" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-EXECUTION" value="EXECUTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E24AA;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="452" width="300" height="150" as="geometry"/></mxCell><mxCell id="s3-EXECUTION-b" value="DVM — DeroScript / DVM-BASIC&lt;br&gt;smart contracts with private encrypted state&lt;br&gt;tx generation &lt;25 ms · verification &lt;25 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="452" width="1480" height="150" as="geometry"/></mxCell><mxCell id="s3-EXECUTION-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#4277BB;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="527" as="sourcePoint"/><mxPoint x="380" y="527" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-LEDGERSTATE" value="LEDGER &amp; STATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E88E5;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="618" width="300" height="150" as="geometry"/></mxCell><mxCell id="s3-LEDGERSTATE-b" value="DHEBP — homomorphic account model (66 B/account)&lt;br&gt;GravitonDB key/value · merkle-proved · prunable&lt;br&gt;blocks: 10 Σ-blocks (9+1) · 18 s · erasure-coded 48→16&lt;br&gt;mempool · chain state · pruning to a few GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="618" width="1480" height="150" as="geometry"/></mxCell><mxCell id="s3-LEDGERSTATE-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#4277BB;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="693" as="sourcePoint"/><mxPoint x="380" y="693" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-CONSENSUS" value="CONSENSUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FB8C00;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="784" width="300" height="150" as="geometry"/></mxCell><mxCell id="s3-CONSENSUS-b" value="AstroBWTv3 PoW — CPU-only, ≈256 MB/thread&lt;br&gt;difficulty retarget every block · 18 s pace&lt;br&gt;Σ-block rewards split to winners · network IS the pool&lt;br&gt;supply: halving ~4 yr · hard cap ≈20.89M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="784" width="1480" height="150" as="geometry"/></mxCell><mxCell id="s3-CONSENSUS-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#4277BB;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="859" as="sourcePoint"/><mxPoint x="380" y="859" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-CRYPTOGRAPHY" value="CRYPTOGRAPHY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="300" height="150" as="geometry"/></mxCell><mxCell id="s3-CRYPTOGRAPHY-b" value="Homomorphic encryption — compute on ciphertext&lt;br&gt;ring signatures (ring 8 default) · 6 bound proofs&lt;br&gt;Pedersen commitments + bulletproofs&lt;br&gt;TLS · AstroBWTv3 memory-hard PoW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="950" width="1480" height="150" as="geometry"/></mxCell><mxCell id="s3-CRYPTOGRAPHY-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#4277BB;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1025" as="sourcePoint"/><mxPoint x="380" y="1025" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-f" value="Reading it bottom-up: the math (crypto) makes consensus honest → consensus writes a private ledger → the VM runs programs on it → interfaces expose it → applications use it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12.5;fontColor=#5A6B7A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1132" width="1800" height="60" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="src-tree" name="Source-Tree Map">
