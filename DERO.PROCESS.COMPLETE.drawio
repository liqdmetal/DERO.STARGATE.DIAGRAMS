  <diagram id="translation" name="Plain-Language Translation">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="906" width="380" height="34" as="geometry"/></mxCell><mxCell id="p2t" value="THE SAME JOURNEY IN PLAIN WORDS" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="40" as="geometry"/></mxCell><mxCell id="p2s" value="Print or share this page with a non-technical audience — the companion to the ‘Journey of One Transaction’ diagram." style="text;html=1;align=center;fontSize=13.5;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="p2h1" value="TECH SPEAK → PLAIN SPEAK" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="500" height="26" as="geometry"/></mxCell><mxCell id="p2h2" value="KEY NUMBERS" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="1180" y="115" width="500" height="26" as="geometry"/></mxCell><mxCell id="tp0" value="&lt;b&gt;Homomorphic encryption&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;Math you can add and subtract while it’s still locked in a safe — balances stay secret.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp1" value="&lt;b&gt;Ring signatures (ring of 8)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;You stand in a crowd of 8 people. Nobody can tell which one is you.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp2" value="&lt;b&gt;Zero-knowledge proofs (Bulletproofs)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;‘Trust me, the math is right’ — proven without revealing any secret.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp3" value="&lt;b&gt;Mempool&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;The waiting room for payments that haven’t been written into the ledger yet.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp4" value="&lt;b&gt;AstroBWTv3 proof-of-work&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;A CPU puzzle lottery that keeps the network honest — any PC can play.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp5" value="&lt;b&gt;Mini-blocks (10 per block)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;One notebook page has 10 lines — up to 10 miners get paid per page.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp6" value="&lt;b&gt;Erasure-coded blocks (48 → 16)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;The page is torn into 48 pieces of confetti; any 16 rebuild it. Faster and tougher.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp7" value="&lt;b&gt;DVM + DeroScript&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;Programs (smart contracts) that run on every node and update the encrypted notebook together.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp8" value="&lt;b&gt;66 bytes per account&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;Your whole account state is smaller than this sentence.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp9" value="&lt;b&gt;TLS-encrypted P2P network&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;Nodes talk to each other over a secure, wiretap-proof line.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp10" value="&lt;b&gt;28-byte data payload&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;A tiny note glued to a payment — a message that travels with it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="1080" height="52" as="geometry"/></mxCell><mxCell id="tp11" value="&lt;b&gt;18 s blocks / ~1 min confirmation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;A new page every 18 seconds; your payment is officially settled in about a minute.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E3;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="1080" height="52" as="geometry"/></mxCell><mxCell id="kn0" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;18 s&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;average block time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn1" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;10 (9+1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;mini-blocks per block (≈1 every 2 s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="210" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn2" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;default ring size (anonymity set)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn3" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;~2.5 KB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;transaction size (ring 8)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="330" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn4" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;&lt; 25 ms&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;generate / verify a transaction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="390" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn5" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;66 B&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;on-chain state per account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="450" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn6" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;28 B&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;max data payload per transaction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="510" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn7" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;48 → 16&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;erasure chunks → needed to rebuild&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn8" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;≈20.89 M&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;hard cap · halving every 4 years&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="630" width="660" height="52" as="geometry"/></mxCell><mxCell id="kn9" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;CPU-only&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;AstroBWTv3 — ASIC/GPU resistant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="690" width="660" height="52" as="geometry"/></mxCell><mxCell id="p2f" value="DHEBP = DERO Homomorphic Encryption Blockchain Protocol · codename Stargate · Diagram v1 — collaborative repo: github.com/liqdmetal/DERO.STARGATE.DIAGRAMS" style="text;html=1;align=center;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1880" height="20" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
