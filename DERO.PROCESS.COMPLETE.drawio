<mxfile host="app.diagrams.net" modified="2026-08-18T04:35:59.000Z" agent="Hermes-AI" version="24.4.8" type="device">
  <diagram id="journey" name="The Journey of One Transaction">
<mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="1356" width="380" height="34" as="geometry"/></mxCell><mxCell id="t1" value="THE JOURNEY OF ONE DERO TRANSACTION" style="text;html=1;align=center;fontSize=30;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="t2" value="From your wallet → through the network → into the encrypted ledger (DLT) → confirmation back to you.  Follow the numbers 1 → 14 · 💡 lines = plain talk · green arrows = confirmation back to you." style="text;html=1;align=center;fontSize=14;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="t3" value="DERO · DHEBP (Stargate) · Layer 1" style="rounded=1;html=1;fillColor=#EAF2FB;strokeColor=#4277BB;fontColor=#4277BB;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1600" y="66" width="290" height="30" as="geometry"/></mxCell><mxCell id="lane-user" value="" style="rounded=0;html=1;fillColor=#FFF8E1;strokeColor=#D8E2EC;strokeWidth=1;opacity=70;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="1540" height="130" as="geometry"/></mxCell><mxCell id="lane-t-user" value="👤 YOU" style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="28" y="144" width="200" height="26" as="geometry"/></mxCell><mxCell id="lane-s-user" value="the human" style="text;html=1;align=left;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="28" y="174" width="200" height="18" as="geometry"/></mxCell><mxCell id="lane-wallet" value="" style="rounded=0;html=1;fillColor=#E8F5E9;strokeColor=#D8E2EC;strokeWidth=1;opacity=70;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1540" height="200" as="geometry"/></mxCell><mxCell id="lane-t-wallet" value="👤 YOUR WALLET" style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#43A047;" vertex="1" parent="1"><mxGeometry x="28" y="284" width="200" height="26" as="geometry"/></mxCell><mxCell id="lane-s-wallet" value="the app on your device" style="text;html=1;align=left;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="28" y="314" width="200" height="18" as="geometry"/></mxCell><mxCell id="lane-node" value="" style="rounded=0;html=1;fillColor=#E3F2FD;strokeColor=#D8E2EC;strokeWidth=1;opacity=70;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1540" height="140" as="geometry"/></mxCell><mxCell id="lane-t-node" value="👤 YOUR NODE" style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="28" y="494" width="200" height="26" as="geometry"/></mxCell><mxCell id="lane-s-node" value="your computer, on the network" style="text;html=1;align=left;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="28" y="524" width="200" height="18" as="geometry"/></mxCell><mxCell id="lane-network" value="" style="rounded=0;html=1;fillColor=#F3E5F5;strokeColor=#D8E2EC;strokeWidth=1;opacity=70;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1540" height="160" as="geometry"/></mxCell><mxCell id="lane-t-network" value="👤 THE NETWORK" style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="28" y="644" width="200" height="26" as="geometry"/></mxCell><mxCell id="lane-s-network" value="every node worldwide" style="text;html=1;align=left;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="28" y="674" width="200" height="18" as="geometry"/></mxCell><mxCell id="lane-miners" value="" style="rounded=0;html=1;fillColor=#FFF3E0;strokeColor=#D8E2EC;strokeWidth=1;opacity=70;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1540" height="180" as="geometry"/></mxCell><mxCell id="lane-t-miners" value="👤 MINERS" style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#FB8C00;" vertex="1" parent="1"><mxGeometry x="28" y="814" width="200" height="26" as="geometry"/></mxCell><mxCell id="lane-s-miners" value="CPU puzzle solvers" style="text;html=1;align=left;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="28" y="844" width="200" height="18" as="geometry"/></mxCell><mxCell id="lane-ledger" value="" style="rounded=0;html=1;fillColor=#E0F7FA;strokeColor=#D8E2EC;strokeWidth=1;opacity=70;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="1540" height="170" as="geometry"/></mxCell><mxCell id="lane-t-ledger" value="👤 THE LEDGER" style="text;html=1;align=left;fontSize=19;fontStyle=1;fontColor=#00838F;" vertex="1" parent="1"><mxGeometry x="28" y="1004" width="200" height="26" as="geometry"/></mxCell><mxCell id="lane-s-ledger" value="the shared encrypted record (DLT)" style="text;html=1;align=left;fontSize=11;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="28" y="1034" width="200" height="18" as="geometry"/></mxCell><mxCell id="s1" value="&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;1 · YOU want to send DERO (or use a dApp)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;You open your wallet — CLI, GUI, web or mobile — enter an amount, or open a&lt;br&gt;decentralized app built on DERO.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 You tap ‘Send’, like a banking app — but there’s no bank, and nobody can see the amount.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="250" y="144" width="520" height="105" as="geometry"/></mxCell><mxCell id="bd1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="233" y="127" width="34" height="34" as="geometry"/></mxCell><mxCell id="s2" value="&lt;font color=&quot;#43A047&quot;&gt;&lt;b&gt;2 · WALLET builds a sealed envelope (≈25 ms)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Picks a ring of 8 accounts (yours + 7 decoys) · hides the amount with homomorphic encryption + a&lt;br&gt;Pedersen commitment · attaches six bound zero-knowledge proofs (ring, range, balance…) · optional&lt;br&gt;28-byte message.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The app wraps your payment in unbreakable math — identity and amount sealed, even from the network.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="250" y="284" width="600" height="120" as="geometry"/></mxCell><mxCell id="bd2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#43A047;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="233" y="267" width="34" height="34" as="geometry"/></mxCell><mxCell id="s3" value="&lt;font color=&quot;#43A047&quot;&gt;&lt;b&gt;3 · WALLET signs with your private key&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Your key authorizes the tx on your device and never leaves&lt;br&gt;it. Nobody can tell which of the 8 ring accounts is really&lt;br&gt;yours.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Only your key can approve a payment. It never leaves your phone&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 or PC.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="880" y="284" width="380" height="134" as="geometry"/></mxCell><mxCell id="bd3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#43A047;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="863" y="267" width="34" height="34" as="geometry"/></mxCell><mxCell id="s4" value="&lt;font color=&quot;#1E88E5&quot;&gt;&lt;b&gt;4 · YOUR NODE receives it (RPC)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;The wallet hands the tx to your daemon over local RPC. Quick checks:&lt;br&gt;format, fee, proofs.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your node = the post office that sends your envelope on its way.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="250" y="494" width="430" height="105" as="geometry"/></mxCell><mxCell id="bd4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E88E5;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="233" y="477" width="34" height="34" as="geometry"/></mxCell><mxCell id="s5" value="&lt;font color=&quot;#1E88E5&quot;&gt;&lt;b&gt;5 · YOUR NODE adds it to the mempool&lt;/b&gt;&lt;/font&gt;&lt;br&gt;The pool of unconfirmed transactions, shared with every peer.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The waiting room. Your tx waits for a miner to pick it up.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="700" y="494" width="430" height="90" as="geometry"/></mxCell><mxCell id="bd5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E88E5;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="683" y="477" width="34" height="34" as="geometry"/></mxCell><mxCell id="s6" value="&lt;font color=&quot;#8E24AA&quot;&gt;&lt;b&gt;6 · NETWORK broadcasts it (TLS P2P)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nodes gossip the tx over TLS-encrypted connections (P2P port 10101). Within seconds, every&lt;br&gt;node has a copy.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 A secret whisper spreads through the crowd — everyone hears it, the message stays sealed.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="250" y="644" width="560" height="105" as="geometry"/></mxCell><mxCell id="bd6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8E24AA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="233" y="627" width="34" height="34" as="geometry"/></mxCell><mxCell id="s7" value="&lt;font color=&quot;#8E24AA&quot;&gt;&lt;b&gt;7 · NETWORK verifies the envelope&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Each node checks signature, zero-knowledge proofs and balance — computed on the ENCRYPTED&lt;br&gt;data (homomorphic math) — plus the double-spend check. ≈25 ms.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Every node checks your sealed envelope without ever opening it. Anything wrong → rejected.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="830" y="644" width="560" height="105" as="geometry"/></mxCell><mxCell id="bd7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8E24AA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="813" y="627" width="34" height="34" as="geometry"/></mxCell><mxCell id="s8" value="&lt;font color=&quot;#FB8C00&quot;&gt;&lt;b&gt;8 · MINERS race: AstroBWTv3 PoW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;CPU-only, memory-hard puzzle. ASIC/GPU-resistant → any PC can&lt;br&gt;mine. Difficulty re-targets every block.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 A CPU lottery. The winner writes the next page of the notebook —&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 and earns DERO.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="250" y="814" width="380" height="119" as="geometry"/></mxCell><mxCell id="bd8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FB8C00;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="233" y="797" width="34" height="34" as="geometry"/></mxCell><mxCell id="s9" value="&lt;font color=&quot;#FB8C00&quot;&gt;&lt;b&gt;9 · MINERS pack the block &amp; earn rewards&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Verified txs are packed into a block — 9 fast mini-blocks + 1&lt;br&gt;final (10 per block, one every ~2 sec), so up to 10 miners&lt;br&gt;share each reward.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your envelope is now on the winning page — part of the official&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 record.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="650" y="814" width="380" height="134" as="geometry"/></mxCell><mxCell id="bd9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FB8C00;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="633" y="797" width="34" height="34" as="geometry"/></mxCell><mxCell id="s10" value="&lt;font color=&quot;#FB8C00&quot;&gt;&lt;b&gt;10 · Block spreads &amp; every node re-checks&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Erasure-coded into 48 chunks; any 16 rebuild the whole block. All nodes&lt;br&gt;re-validate before accepting. Consensus: one agreed chain.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The page is shredded into confetti — anyone with 16 pieces can rebuild and&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 re-check the math.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="1060" y="814" width="460" height="119" as="geometry"/></mxCell><mxCell id="bd10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FB8C00;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1043" y="797" width="34" height="34" as="geometry"/></mxCell><mxCell id="s11" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;11 · LEDGER updates (still encrypted)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Balances settle by homomorphic addition/subtraction on ciphertext — never decrypted, ever.&lt;br&gt;Just 66 bytes per account. Smart contracts (DVM · DeroScript) update encrypted state too.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The notebook is updated. Your balance changed — but the number is still invisible to everyone but&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 you.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="250" y="1004" width="560" height="119" as="geometry"/></mxCell><mxCell id="bd11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#00838F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="233" y="987" width="34" height="34" as="geometry"/></mxCell><mxCell id="s12" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;12 · The record becomes permanent&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Blocks are chained and merkle-proved. Supply stays auditable (hard cap&lt;br&gt;≈20.89M DERO). History can be pruned to a few GB. The past cannot be&lt;br&gt;rewritten.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 What’s written stays written. No erasers on this notebook.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="830" y="1004" width="430" height="120" as="geometry"/></mxCell><mxCell id="bd12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#00838F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="813" y="987" width="34" height="34" as="geometry"/></mxCell><mxCell id="s13" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;13 · CONFIRMED in ~1 minute&lt;/b&gt;&lt;/font&gt;&lt;br&gt;After a few 18-second blocks, your tx is&lt;br&gt;confirmed. Your wallet reads the encrypted&lt;br&gt;balance and decrypts it locally with your key.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The network agrees — your app shows the new&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 balance. Only your app can read it.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="1600" y="300" width="290" height="134" as="geometry"/></mxCell><mxCell id="bd13" value="13" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1583" y="283" width="34" height="34" as="geometry"/></mxCell><mxCell id="s14" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;14 · You get a private receipt&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Prove ‘I sent exactly X’ without revealing&lt;br&gt;your identity or balance. dApps see their&lt;br&gt;state update too.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 A receipt that shows the total — but not your&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 name. Privacy AND proof.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=18;fontSize=10.5;fontColor=#22303C;shadow=0;" vertex="1" parent="1"><mxGeometry x="1600" y="480" width="290" height="134" as="geometry"/></mxCell><mxCell id="bd14" value="14" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1583" y="463" width="34" height="34" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510.0" y="249" as="sourcePoint"/><mxPoint x="550.0" y="284" as="targetPoint"/><Array as="points"><mxPoint x="510.0" y="267"/><mxPoint x="530.0" y="267"/><mxPoint x="530.0" y="272"/><mxPoint x="550.0" y="272"/></Array></mxGeometry><mxCell id="e1-l" value="sends the envelope" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#0076BE;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint x="-25.0" y="-20" as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="344.0" as="sourcePoint"/><mxPoint x="880" y="351.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="418" as="sourcePoint"/><mxPoint x="465.0" y="494" as="targetPoint"/><Array as="points"><mxPoint x="1070.0" y="436"/><mxPoint x="767.5" y="436"/><mxPoint x="767.5" y="482"/><mxPoint x="465.0" y="482"/></Array></mxGeometry><mxCell id="e3-l" value="to your node" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#0076BE;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint x="317.5" y="-12" as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="546.5" as="sourcePoint"/><mxPoint x="700" y="539.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915.0" y="584" as="sourcePoint"/><mxPoint x="530.0" y="644" as="targetPoint"/><Array as="points"><mxPoint x="915.0" y="602"/><mxPoint x="722.5" y="602"/><mxPoint x="722.5" y="632"/><mxPoint x="530.0" y="632"/></Array></mxGeometry><mxCell id="e5-l" value="broadcast to the network" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#0076BE;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint x="217.5" y="-12" as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="696.5" as="sourcePoint"/><mxPoint x="830" y="696.5" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110.0" y="749" as="sourcePoint"/><mxPoint x="440.0" y="814" as="targetPoint"/><Array as="points"><mxPoint x="1110.0" y="767"/><mxPoint x="775.0" y="767"/><mxPoint x="775.0" y="802"/><mxPoint x="440.0" y="802"/></Array></mxGeometry><mxCell id="e7-l" value="verified txs enter blocks" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#0076BE;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint x="360.0" y="-20" as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="873.5" as="sourcePoint"/><mxPoint x="650" y="881.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="881.0" as="sourcePoint"/><mxPoint x="1060" y="873.5" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290.0" y="933" as="sourcePoint"/><mxPoint x="530.0" y="1004" as="targetPoint"/><Array as="points"><mxPoint x="1290.0" y="951"/><mxPoint x="910.0" y="951"/><mxPoint x="910.0" y="992"/><mxPoint x="530.0" y="992"/></Array></mxGeometry><mxCell id="e10-l" value="block accepted by all" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#0076BE;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint x="405.0" y="-32" as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#0076BE;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="1063.5" as="sourcePoint"/><mxPoint x="830" y="1064.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="1064.0" as="sourcePoint"/><mxPoint x="1830" y="300" as="targetPoint"/><Array as="points"><mxPoint x="1830" y="1064.0"/></Array></mxGeometry></mxCell><mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745.0" y="434" as="sourcePoint"/><mxPoint x="1745.0" y="480" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="547.0" as="sourcePoint"/><mxPoint x="1450" y="185" as="targetPoint"/><Array as="points"><mxPoint x="1450" y="547.0"/></Array></mxGeometry><mxCell id="r3-l" value="back to you ✓" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint x="12" y="-312.0" as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="r1-lb" value="✓ CONFIRMED (≈1 MIN)&lt;br&gt;your wallet decrypts&lt;br&gt;your new balance —&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;only you can read it&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontColor=#22303C;align=center;" vertex="1" parent="1"><mxGeometry x="1600" y="640" width="228" height="92" as="geometry"/></mxCell><mxCell id="f1" value="THE WHOLE POINT" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="40" y="1185" width="300" height="22" as="geometry"/></mxCell><mxCell id="f2" value="Your money never leaves your control. The network never sees your amount, your identity, or your balance — it only agrees, in math, that everything adds up. That is how DERO replaces banks, clouds and databases with one shared, private, tamper-proof notebook." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=13.5;fontColor=#22303C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="1500" height="96" as="geometry"/></mxCell><mxCell id="lg" value="LEGEND" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="1600" y="1185" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg-chip-user" value="" style="rounded=1;html=1;fillColor=#F9A825;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1216" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-user" value="👤 YOU — the human" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1213" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-wallet" value="" style="rounded=1;html=1;fillColor=#43A047;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1240" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-wallet" value="💼 YOUR WALLET — the app" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1237" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-node" value="" style="rounded=1;html=1;fillColor=#1E88E5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1264" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-node" value="📡 YOUR NODE — your daemon" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1261" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-network" value="" style="rounded=1;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1288" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-network" value="🌐 THE NETWORK — every node" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1285" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-miners" value="" style="rounded=1;html=1;fillColor=#FB8C00;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1312" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-miners" value="⛏️ MINERS — PoW consensus" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1309" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-ledger" value="" style="rounded=1;html=1;fillColor=#00838F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1336" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-ledger" value="📒 THE LEDGER — shared DLT" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1333" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-confirm" value="" style="rounded=1;html=1;fillColor=#2E7D32;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1610" y="1360" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-confirm" value="↩ Confirmation back to you" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1357" width="240" height="18" as="geometry"/></mxCell><mxCell id="lg-chip-edge" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#0076BE;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1610" y="1384" width="22" height="14" as="geometry"/></mxCell><mxCell id="lg-t-edge" value="&#8595; ↓ The transaction’s journey" style="text;html=1;align=left;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1640" y="1381" width="240" height="18" as="geometry"/></mxCell></root></mxGraphModel>
