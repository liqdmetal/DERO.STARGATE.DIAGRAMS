<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-25T13:35:00.000Z" agent="Hermes-AI" version="24.4.8" type="device" background="#0B1220">
  <diagram id="world" name="DERO Place in the Modern World">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="1354" width="400" height="34" as="geometry"/></mxCell><mxCell id="w-t" value="DERO’S PLACE IN THE MODERN WORLD" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="w-t-s" value="Same everyday needs · completely different plumbing — how the DHEBP stack replaces banks, clouds and middlemen." style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="1880" height="22" as="geometry"/></mxCell><mxCell id="lg0" value="what you need" style="text;html=1;align=left;fontSize=11.5;fontStyle=1;fontColor=#FBBF24;" vertex="1" parent="1"><mxGeometry x="60" y="102" width="320" height="18" as="geometry"/></mxCell><mxCell id="lg1" value="old world — centralized" style="text;html=1;align=left;fontSize=11.5;fontStyle=1;fontColor=#F87171;" vertex="1" parent="1"><mxGeometry x="420" y="102" width="320" height="18" as="geometry"/></mxCell><mxCell id="lg2" value="DERO world — private" style="text;html=1;align=left;fontSize=11.5;fontStyle=1;fontColor=#34D399;" vertex="1" parent="1"><mxGeometry x="780" y="102" width="320" height="18" as="geometry"/></mxCell><mxCell id="lg3" value="→ replaced by" style="text;html=1;align=left;fontSize=11.5;fontStyle=1;fontColor=#;" vertex="1" parent="1"><mxGeometry x="1140" y="102" width="320" height="18" as="geometry"/></mxCell><mxCell id="c-6" value="&lt;font color=&quot;#FBBF24&quot;&gt;&lt;b&gt;1 · PAYING SOMEONE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Send money to anyone, anywhere" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="30" y="132" width="330" height="176" as="geometry"/></mxCell><mxCell id="c-7" value="&lt;font color=&quot;#F87171&quot;&gt;&lt;b&gt;Bank or payment app&lt;/b&gt;&lt;/font&gt;&lt;br&gt;They see every payment, can freeze or censor you, charge fees, demand ID.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 The bank is the referee — and it keeps the ball.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390" y="132" width="560" height="176" as="geometry"/></mxCell><mxCell id="c-8" value="&lt;font color=&quot;#34D399&quot;&gt;&lt;b&gt;Direct private transfer (DHEBP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Amount + identity hidden by homomorphic encryption. Settled in ~1 min, tiny ~2.5 KB tx, tiny fee.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Only you and the recipient know what moved.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="980" y="132" width="630" height="176" as="geometry"/></mxCell><mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#34D399;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="954" y="220" as="sourcePoint"/><mxPoint x="976" y="220" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="a0-l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#141E36;fontSize=11;fontStyle=1;fontColor=#34D399;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="c-10" value="&lt;font color=&quot;#FBBF24&quot;&gt;&lt;b&gt;2 · MAKING A DEAL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Agree on terms both sides will honor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="30" y="316" width="330" height="176" as="geometry"/></mxCell><mxCell id="c-11" value="&lt;font color=&quot;#F87171&quot;&gt;&lt;b&gt;Lawyer, notary or platform&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Holds the money and the trust: slow, costly, and you must trust them.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Trust is rented from a third party.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390" y="316" width="560" height="176" as="geometry"/></mxCell><mxCell id="c-12" value="&lt;font color=&quot;#34D399&quot;&gt;&lt;b&gt;DVM smart contract (DeroScript)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Code is the escrow: it runs on every node, nobody can break or rewrite it. Escrow, tokens, auctions,&lt;br&gt;lotteries.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Trust is replaced by math everyone can check.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="980" y="316" width="630" height="176" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#34D399;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="954" y="404" as="sourcePoint"/><mxPoint x="976" y="404" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="a1-l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#141E36;fontSize=11;fontStyle=1;fontColor=#34D399;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="c-14" value="&lt;font color=&quot;#FBBF24&quot;&gt;&lt;b&gt;3 · STORING RECORDS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Keep data safe, private, permanent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="330" height="176" as="geometry"/></mxCell><mxCell id="c-15" value="&lt;font color=&quot;#F87171&quot;&gt;&lt;b&gt;Company cloud (AWS, Google…)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;They read, sell, or lose your data; one breach exposes everything.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Your data in someone else’s filing cabinet.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390" y="500" width="560" height="176" as="geometry"/></mxCell><mxCell id="c-16" value="&lt;font color=&quot;#34D399&quot;&gt;&lt;b&gt;Encrypted ledger + GravitonDB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Accounts are 66 bytes of encrypted state, never decrypted, merkle-proved, prunable to a few GB.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 A lockbox only you can open.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="630" height="176" as="geometry"/></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#34D399;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="954" y="588" as="sourcePoint"/><mxPoint x="976" y="588" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="a2-l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#141E36;fontSize=11;fontStyle=1;fontColor=#34D399;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="c-18" value="&lt;font color=&quot;#FBBF24&quot;&gt;&lt;b&gt;4 · RUNNING AN APP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Host software people can use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="30" y="684" width="330" height="176" as="geometry"/></mxCell><mxCell id="c-19" value="&lt;font color=&quot;#F87171&quot;&gt;&lt;b&gt;Web server + domain + hosting&lt;/b&gt;&lt;/font&gt;&lt;br&gt;One point of failure: can be blocked, hacked, or switched off.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Your shop sits on someone else’s land.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390" y="684" width="560" height="176" as="geometry"/></mxCell><mxCell id="c-20" value="&lt;font color=&quot;#34D399&quot;&gt;&lt;b&gt;TELA — apps on the chain&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Code and assets live on-chain, served by the network itself. No origin server to attack or censor.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Your shop is on everyone’s land — and nobody owns it.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="980" y="684" width="630" height="176" as="geometry"/></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#34D399;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="954" y="772" as="sourcePoint"/><mxPoint x="976" y="772" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="a3-l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#141E36;fontSize=11;fontStyle=1;fontColor=#34D399;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="c-22" value="&lt;font color=&quot;#FBBF24&quot;&gt;&lt;b&gt;5 · PROVING WHO YOU ARE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Authenticate without being spied on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="30" y="868" width="330" height="176" as="geometry"/></mxCell><mxCell id="c-23" value="&lt;font color=&quot;#F87171&quot;&gt;&lt;b&gt;Passwords + emails + data brokers&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Leaks, phishing, and your identity bought and sold.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 You flash your whole wallet to prove you’re an adult.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390" y="868" width="560" height="176" as="geometry"/></mxCell><mxCell id="c-24" value="&lt;font color=&quot;#34D399&quot;&gt;&lt;b&gt;Wallet + DeroAuth + usernames&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Sign in with your wallet (XSWD bridge); the DVM Name Service gives human names; zero-knowledge&lt;br&gt;proofs reveal only what’s needed.&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;&lt;i&gt;💡 Prove you’re over 18 without showing your ID.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=11.5;fontColor=#E8EEF7;align=left;verticalAlign=top;spacing=10;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="980" y="868" width="630" height="176" as="geometry"/></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#34D399;strokeWidth=3;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="954" y="956" as="sourcePoint"/><mxPoint x="976" y="956" as="targetPoint"/><Array as="points"></Array></mxGeometry><mxCell id="a4-l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#141E36;fontSize=11;fontStyle=1;fontColor=#34D399;" vertex="1" connectable="0"><mxGeometry x="0.5" y="0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="w-tool" value="THE DERO TOOLBOX" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#2DD4BF;" vertex="1" parent="1"><mxGeometry x="1646" y="130" width="230" height="22" as="geometry"/></mxCell><mxCell id="tb-DHE" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;DHEBP · Layer 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;encrypted chain · PoW AstroBWTv3 · 18 s blocks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="158" width="250" height="62" as="geometry"/></mxCell><mxCell id="tb-DVM" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;DVM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;smart contracts · DeroScript&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="226" width="250" height="62" as="geometry"/></mxCell><mxCell id="tb-Gra" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;GravitonDB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;encrypted key/value state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="294" width="250" height="62" as="geometry"/></mxCell><mxCell id="tb-TEL" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;TELA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;on-chain apps &amp; web — no server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="362" width="250" height="62" as="geometry"/></mxCell><mxCell id="tb-XSW" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;XSWD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;app ↔ wallet bridge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="430" width="250" height="62" as="geometry"/></mxCell><mxCell id="tb-Der" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;DeroAuth / DeroPay&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;sign in · pay with your wallet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="498" width="250" height="62" as="geometry"/></mxCell><mxCell id="tb-Nam" value="&lt;font color=&quot;#2DD4BF&quot;&gt;&lt;b&gt;Name Service&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3BF&quot;&gt;human usernames on-chain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;shadow=1;fontSize=10.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="566" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-f1" value="THE SAME JOB — NO MIDDLEMAN" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="420" height="22" as="geometry"/></mxCell><mxCell id="w-f2" value="Money, deals, data, apps, identity — the modern world runs them on banks, clouds and platforms. DERO runs them on one shared, private, tamper-proof network: every node does the job, and none of them can see your business." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#;strokeWidth=1.5;shadow=1;fontSize=13.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1810" height="96" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="swap" name="The Swap Table">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="866" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="820" width="400" height="34" as="geometry"/></mxCell><mxCell id="s-t" value="THE SWAP TABLE" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="s-t-s" value="Every centralized service you use today has a DERO-native replacement. Same job, no middleman." style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="1880" height="22" as="geometry"/></mxCell><mxCell id="s-h0" value="CENTRALIZED SERVICE TODAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F87171;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="640" height="34" as="geometry"/></mxCell><mxCell id="s-h1" value="DERO REPLACEMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34D399;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="640" height="34" as="geometry"/></mxCell><mxCell id="s-h2" value="WHAT CHANGES FOR YOU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2DD4BF;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="1380" 