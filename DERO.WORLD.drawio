ity system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="640" height="64" as="geometry"/></mxCell><mxCell id="s-r4c1" value="Wallet + DeroAuth + Name Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="640" height="64" as="geometry"/></mxCell><mxCell id="s-r4c2" value="Prove only what’s needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="440" width="480" height="64" as="geometry"/></mxCell><mxCell id="s-r5c0" value="Exchange / auction / lottery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="512" width="640" height="64" as="geometry"/></mxCell><mxCell id="s-r5c1" value="DVM tokens &amp; contracts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="512" width="640" height="64" as="geometry"/></mxCell><mxCell id="s-r5c2" value="Transparent rules, private state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="512" width="480" height="64" as="geometry"/></mxCell><mxCell id="s-r6c0" value="Auditing &amp; compliance" style="rounded=1;whiteSpace=wrap;html=1