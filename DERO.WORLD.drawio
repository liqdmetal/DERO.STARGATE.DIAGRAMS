<mxfile host="app.diagrams.net" modified="2026-08-18T03:01:57.000Z" agent="Hermes-AI" version="24.4.8" type="device">
  <diagram id="world" name="DERO Place in the Modern World">
<mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="1356" width="380" height="34" as="geometry"/></mxCell><mxCell id="w-t1" value="DERO&apos;S PLACE IN THE MODERN WORLD" style="text;html=1;align=center;fontSize=30;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="w-t2" value="Same everyday needs. Completely different plumbing. — How the DHEBP stack replaces banks, clouds and middlemen." style="text;html=1;align=center;fontSize=14;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="w-t3" value="DERO · DHEBP (Stargate) · Layer 1 → 2" style="rounded=1;html=1;fillColor=#EAF2FB;strokeColor=#4277BB;fontColor=#4277BB;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1600" y="66" width="290" height="30" as="geometry"/></mxCell><mxCell id="w-lg1" value="" style="rounded=1;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="102" width="20" height="12" as="geometry"/></mxCell><mxCell id="w-lg1t" value="what you need" style="text;html=1;align=left;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="86" y="98" width="130" height="18" as="geometry"/></mxCell><mxCell id="w-lg2" value="" style="rounded=1;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="240" y="102" width="20" height="12" as="geometry"/></mxCell><mxCell id="w-lg2t" value="old world — centralized" style="text;html=1;align=left;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="266" y="98" width="190" height="18" as="geometry"/></mxCell><mxCell id="w-lg3" value="" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="102" width="20" height="12" as="geometry"/></mxCell><mxCell id="w-lg3t" value="DERO world — decentralized &amp; private" style="text;html=1;align=left;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="506" y="98" width="280" height="18" as="geometry"/></mxCell><mxCell id="w-lg4" value="→ replaced by" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="790" y="98" width="120" height="18" as="geometry"/></mxCell><mxCell id="w-n0" value="&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;1 · PAYING SOMEONE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Send money to anyone, anywhere" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="30" y="132" width="330" height="176" as="geometry"/></mxCell><mxCell id="w-o0" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Bank or payment app&lt;/b&gt;&lt;/font&gt;&lt;br&gt;They see every payment, can freeze or censor you, charge fees, demand ID.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 The bank is the referee — and it keeps the ball.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="390" y="132" width="560" height="176" as="geometry"/></mxCell><mxCell id="w-d0" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;Direct private transfer (DHEBP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Amount + identity hidden by homomorphic encryption. Settled in ~1 min, tiny ~2.5 KB tx, tiny fee.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Only you and the recipient know what moved.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="980" y="132" width="630" height="176" as="geometry"/></mxCell><mxCell id="w-a0" value="replaced by" style="edgeStyle=none;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="220.0" as="sourcePoint"/><mxPoint x="980" y="220.0" as="targetPoint"/></mxGeometry><mxCell id="w-a0l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="w-n1" value="&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;2 · MAKING A DEAL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Agree on terms both sides will honor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="30" y="316" width="330" height="176" as="geometry"/></mxCell><mxCell id="w-o1" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Lawyer, notary or platform&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Holds the money and the trust: slow, costly, and you must trust them.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Trust is rented from a third party.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="390" y="316" width="560" height="176" as="geometry"/></mxCell><mxCell id="w-d1" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DVM smart contract (DeroScript)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Code is the escrow: it runs on every node, nobody can break or rewrite it. Escrow, tokens, auctions,&lt;br&gt;lotteries.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Trust is replaced by math everyone can check.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="980" y="316" width="630" height="176" as="geometry"/></mxCell><mxCell id="w-a1" value="replaced by" style="edgeStyle=none;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="404.0" as="sourcePoint"/><mxPoint x="980" y="404.0" as="targetPoint"/></mxGeometry><mxCell id="w-a1l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="w-sep1" value="" style="line;strokeWidth=1;strokeColor=#D8E2EC;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="308" width="1880" height="1" as="geometry"/></mxCell><mxCell id="w-n2" value="&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;3 · STORING RECORDS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Keep data safe, private, permanent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="330" height="176" as="geometry"/></mxCell><mxCell id="w-o2" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Company cloud (AWS, Google…)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;They read, sell, or lose your data; one breach exposes everything.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your data in someone else’s filing cabinet.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="390" y="500" width="560" height="176" as="geometry"/></mxCell><mxCell id="w-d2" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;Encrypted ledger + GravitonDB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Accounts are 66 bytes of encrypted state, never decrypted, merkle-proved, prunable to a few GB.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 A lockbox only you can open.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="630" height="176" as="geometry"/></mxCell><mxCell id="w-a2" value="replaced by" style="edgeStyle=none;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="588.0" as="sourcePoint"/><mxPoint x="980" y="588.0" as="targetPoint"/></mxGeometry><mxCell id="w-a2l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="w-sep2" value="" style="line;strokeWidth=1;strokeColor=#D8E2EC;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="492" width="1880" height="1" as="geometry"/></mxCell><mxCell id="w-n3" value="&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;4 · RUNNING AN APP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Host software people can use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="30" y="684" width="330" height="176" as="geometry"/></mxCell><mxCell id="w-o3" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Web server + domain + hosting&lt;/b&gt;&lt;/font&gt;&lt;br&gt;One point of failure: can be blocked, hacked, or switched off.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your shop sits on someone else’s land.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="390" y="684" width="560" height="176" as="geometry"/></mxCell><mxCell id="w-d3" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;TELA — apps on the chain&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Code and assets live on-chain, served by the network itself. No origin server to attack or censor.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Your shop is on everyone’s land — and nobody owns it.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="980" y="684" width="630" height="176" as="geometry"/></mxCell><mxCell id="w-a3" value="replaced by" style="edgeStyle=none;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="772.0" as="sourcePoint"/><mxPoint x="980" y="772.0" as="targetPoint"/></mxGeometry><mxCell id="w-a3l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="w-sep3" value="" style="line;strokeWidth=1;strokeColor=#D8E2EC;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="676" width="1880" height="1" as="geometry"/></mxCell><mxCell id="w-n4" value="&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;5 · PROVING WHO YOU ARE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Authenticate without being spied on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="30" y="868" width="330" height="176" as="geometry"/></mxCell><mxCell id="w-o4" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Passwords + emails + data brokers&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Leaks, phishing, and your identity bought and sold.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 You flash your whole wallet to prove you’re an adult.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="390" y="868" width="560" height="176" as="geometry"/></mxCell><mxCell id="w-d4" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;Wallet + DeroAuth + usernames&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Sign in with your wallet (XSWD bridge); the DVM Name Service gives human names; zero-knowledge&lt;br&gt;proofs reveal only what’s needed.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;💡 Prove you’re over 18 without showing your ID.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=16;fontSize=11;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="980" y="868" width="630" height="176" as="geometry"/></mxCell><mxCell id="w-a4" value="replaced by" style="edgeStyle=none;rounded=0;html=1;endArrow=classicThin;endFill=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="956.0" as="sourcePoint"/><mxPoint x="980" y="956.0" as="targetPoint"/></mxGeometry><mxCell id="w-a4l" value="replaced by" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#2E7D32;" vertex="1" connectable="0"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell><mxCell id="w-sep4" value="" style="line;strokeWidth=1;strokeColor=#D8E2EC;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="1880" height="1" as="geometry"/></mxCell><mxCell id="w-tool" value="THE DERO TOOLBOX" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#00838F;" vertex="1" parent="1"><mxGeometry x="1646" y="140" width="220" height="22" as="geometry"/></mxCell><mxCell id="w-tb-DHE" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;DHEBP · Layer 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;encrypted chain · PoW AstroBWTv3 · 18 s blocks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="170" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-tb-DVM" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;DVM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;smart contracts · DeroScript&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="240" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-tb-Gra" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;GravitonDB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;encrypted key/value state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="310" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-tb-TEL" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;TELA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;on-chain apps &amp; web — no server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="380" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-tb-XSW" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;XSWD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;app ↔ wallet bridge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="450" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-tb-Der" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;DeroAuth / DeroPay&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;sign in · pay with your wallet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="520" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-tb-Nam" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;Name Service&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;human usernames on-chain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10.5;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="590" width="250" height="62" as="geometry"/></mxCell><mxCell id="w-f1" value="THE SAME JOB — NO MIDDLEMAN" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="420" height="22" as="geometry"/></mxCell><mxCell id="w-f2" value="Money, deals, data, apps, identity — the modern world runs them on banks, clouds and platforms. DERO runs them on one shared, private, tamper-proof network: every node does the job, and none of them can see your business." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=13.5;fontColor=#22303C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1810" height="96" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="swap" name="The Swap Table">
