  <diagram id="economics" name="DERO Economics">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="DERO ECONOMICS" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="The coin-side companion to the mining diagram — emission, halving, cap, and the reward split." style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="pe-0" value="HARD CAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.6;fontSize=13.5;fontStyle=1;fontColor=#34D399;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-0b" value="~20,890,694 DERO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="pe-0d" value="the absolute maximum that can ever exist — sound supply" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="304" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-1" value="EMISSION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#38BDF8;strokeWidth=1.6;fontSize=13.5;fontStyle=1;fontColor=#38BDF8;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-1b" value="via mining rewards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#38BDF8;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="pe-1d" value="all coins are mined — PoW (Σ-blocks), CPU-only" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="460" y="304" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-2" value="HALVING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.6;fontSize=13.5;fontStyle=1;fontColor=#FBBF24;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-2b" value="every ~7,000,000 blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="pe-2d" value="≈ every 4 years, rewards halve — deflationary curve" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="304" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-3" value="REWARD SPLIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#A78BFA;strokeWidth=1.6;fontSize=13.5;fontStyle=1;fontColor=#A78BFA;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1140" y="170" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-3b" value="88.4 / 10 / 1.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#A78BFA;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1140" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="pe-3d" value="miners / [pool or integrator &amp; ecosystem] — DRAFT: verify against source" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1140" y="304" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-4" value="FEES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.6;fontSize=13.5;fontStyle=1;fontColor=#2DD4BF;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1480" y="170" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-4b" value="paid in DERO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1480" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="pe-4d" value="per-tx fees + SC install/registration costs" style="text;html=1;align=center;fontSize=10.5;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480" y="304" width="300" height="52" as="geometry"/></mxCell><mxCell id="pe-f" value="Why it matters: fixed supply + mining-only emission + periodic halving = a predictable, deflationary monetary base — the same properties people look for in ‘sound money.’ Numbers are DRAFT — the exact reward split and halving block height should be verified against derohe source before anyone cites them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#;strokeWidth=1.3;fontSize=13;fontColor=#E8EEF7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="1560" height="76" as="geometry"/></mxCell></root></mxGraphModel>
