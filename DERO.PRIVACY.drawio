  <diagram id="private" name="What Private Actually Means">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="WHAT ‘PRIVATE’ ACTUALLY MEANS" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="Grounded in the code, not the marketing.  DERO hides amounts and identities strongly — but “private” is not “anonymous.”" style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="pv-h" value="HIDDEN — by the protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34D399;strokeColor=none;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="360" height="44" as="geometry"/></mxCell><mxCell id="pv-h0" value="Your balances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-h0d" value="homomorphically encrypted — 66 B/account, never decrypted on-chain" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="230" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-h1" value="Transaction amounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="310" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-h1d" value="encrypted; provable without revealing the value" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="350" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-h2" value="Who sent to whom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-h2d" value="ring signatures (ring 8) mask the true sender/receiver link" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="470" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-h3" value="Contract / dApp state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#34D399;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="120" y="550" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-h3d" value="DVM state is encrypted — only what you approve is visible" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="136" y="590" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-v" value="VISIBLE — metadata &amp; you" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;strokeColor=none;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="360" height="44" as="geometry"/></mxCell><mxCell id="pv-v0" value="Transaction time &amp; size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#FBBF24;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-v0d" value="the chain stores when and how big — metadata is public" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="230" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-v1" value="Node IP / network layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#FBBF24;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="310" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-v1d" value="TLS protects content, but your node’s IP is visible to peers" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="350" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-v2" value="Your node sees your txs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#FBBF24;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="430" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-v2d" value="if you run a node, it knows your wallet’s activity" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="470" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-v3" value="What a dApp is approved to see" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.4;fontSize=14;fontStyle=1;fontColor=#FBBF24;align=left;verticalAlign=middle;spacing=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="550" width="740" height="80" as="geometry"/></mxCell><mxCell id="pv-v3d" value="XSWD exposes exactly the methods you accept — review them" style="text;html=1;align=left;fontSize=11;fontColor=#8FA3BF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="590" width="700" height="36" as="geometry"/></mxCell><mxCell id="pv-f" value="THE HONEST VERSION: DERO’s account model (encrypted balances, no key images, no UTXO decoys) is structurally less heuristic-attackable than Monero’s — but metadata analysis, node-level observation, and poor op-sec still leak.  “Private by default” ≠ “untraceable.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#;strokeWidth=1.5;fontSize=13;fontColor=#E8EEF7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="1560" height="76" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="scorecard" name="Privacy Scorecard">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" background="#0B1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1216;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#FCA5A5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="974" width="400" height="34" as="geometry"/></mxCell><mxCell id="t" value="PRIVACY SCORECARD — DERO vs BTC vs MONERO vs ETH" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#E8EEF7;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="42" as="geometry"/></mxCell><mxCell id="t-s" value="What each chain actually hides.  Honest about residual weaknesses on every side — no marketing." style="text;html=1;align=center;fontSize=13;fontColor=#8FA3BF;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1720" height="22" as="geometry"/></mxCell><mxCell id="pc-h0" value="BITCOIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="360" height="44" as="geometry"/></mxCell><mxCell id="pc-h1" value="MONERO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2DD4BF;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="590" y="130" width="360" height="44" as="geometry"/></mxCell><mxCell id="pc-h2" value="DERO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38BDF8;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="360" height="44" as="geometry"/></mxCell><mxCell id="pc-h3" value="ETHEREUM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A78BFA;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="1370" y="130" width="360" height="44" as="geometry"/></mxCell><mxCell id="pc-r0" value="Balances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12.5;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="86" as="geometry"/></mxCell><mxCell id="pc-r1" value="Amounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12.5;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="150" height="86" as="geometry"/></mxCell><mxCell id="pc-r2" value="Sender → receiver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12.5;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="150" height="86" as="geometry"/></mxCell><mxCell id="pc-r3" value="Heuristic risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12.5;fontStyle=1;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="150" height="86" as="geometry"/></mxCell><mxCell id="pc-c0-0" value="public — every UTXO value on-chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="190" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c0-1" value="public" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="300" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c0-2" value="public — pseudonymous addresses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="410" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c0-3" value="HIGH — change outputs &amp; clustering de-anonymize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="520" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c1-0" value="hidden (RingCT commitments)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="190" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c1-1" value="hidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="300" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c1-2" value="masked (ring sigs, stealth addresses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#2DD4BF;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="410" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c1-3" value="MEDIUM — decoy-selection heuristics still studied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#FBBF24;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c2-0" value="hidden — homomorphic encryption, 66 B/account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#38BDF8;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c2-1" value="hidden — provable without revealing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#38BDF8;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="300" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c2-2" value="masked (ring 8, account model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#38BDF8;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="410" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c2-3" value="LOWER — no key images, no UTXO decoys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#34D399;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c3-0" value="public — account balances &amp; ERC-20 all visible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#A78BFA;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="190" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c3-1" value="public" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#A78BFA;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="300" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c3-2" value="public" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#A78BFA;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="410" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-c3-3" value="HIGH — fully transparent by design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.3;fontSize=11.5;fontColor=#E8EEF7;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="520" width="360" height="86" as="geometry"/></mxCell><mxCell id="pc-f" value="DRAFT — a comparison like this needs a real crypto review before anyone quotes it.  The DERO column reflects the account-model argument (no key images / no UTXO decoys), but “lower heuristic risk” is a claim, not a proof." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141E36;gradientColor=#0F1930;gradientDirection=south;strokeColor=#F87171;strokeWidth=1.3;fontSize=12;fontColor=#E8EEF7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1700" height="56" as="geometry"/></mxCell></root></mxGraphModel>
