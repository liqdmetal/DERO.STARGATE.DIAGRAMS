  <diagram id="experiments" name="Experimental Field Guide">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="1376" width="380" height="34" as="geometry"/></mxCell><mxCell id="x-t1" value="REAL-WORLD USE CASES — THE EXPERIMENTAL FIELD GUIDE" style="text;html=1;align=center;fontSize=30;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="42" as="geometry"/></mxCell><mxCell id="x-t2" value="Twelve ways DERO could work in the real world — what problem each solves, which primitives fit, and where you can start building today.  Status: 🟢 live · 🟡 partial · 🔴 experimental · FILLED BY = real project already in that slot.  Grounded in derod.org’s use-case taxonomy + community repos." style="text;html=1;align=center;fontSize=13.5;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="68" width="1880" height="22" as="geometry"/></mxCell><mxCell id="x-c0" value="&lt;b&gt;🎰 Provably-fair gambling&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;🟢 LIVE — USE IT TODAY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Can you trust the casino’s dice?&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; DVM on-chain RANDOM() + private bets, hidden until reveal&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Fork SixofClubsss/Dero-Baccarat or the lottery.bas tutorial&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;dreamtables (baccarat, poker) · dero_lotto · Dero-Baccarat&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c1" value="&lt;b&gt;🎵 Creator patronage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;🟢 LIVE — USE IT TODAY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Streaming pays artists cents; platforms sell your data&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; DeroBeats: EPOCH mining to artists + instant DERO tips&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Use DeroBeats; register your own track on-chain&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DeroBeats (KalinaLux/derobeats)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c2" value="&lt;b&gt;🗳️ Private DAO voting&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;🔴 EXPERIMENTAL — PROTOTYPE IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Public ballots leak, get coerced, or get bought&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; Encrypted SC state — votes hidden, counts verifiable&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Prototype: STORE votes + SIGNER(), reveal by threshold&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;not filled yet — greenfield&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1360" y="130" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c3" value="&lt;b&gt;🏦 Private lending &amp; DeFi&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;🔴 EXPERIMENTAL — PROTOTYPE IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Aave-style lending exposes your whole position&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; Hidden collateral, encrypted positions, DVM escrow&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Build a collateralized-loan SC on the simulator&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;not filled yet — greenfield&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd3" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="415" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c4" value="&lt;b&gt;🛒 Anonymous marketplace&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;🟡 PARTIAL — BUILD ON IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Marketplaces know every buyer, seller, and price&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; Private payments + TELA storefront + SC escrow&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Fork the marketplace SC; wire an ORED-style asset store&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;Peppinux/dero-marketplace · wizard-grok/ORED&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd4" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685" y="415" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c5" value="&lt;b&gt;🚚 Supply chain, selective disclosure&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;🔴 EXPERIMENTAL — PROTOTYPE IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Proving ‘this is genuine’ reveals your whole supplier network&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; Reveal only what a buyer needs, prove it in math&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Sketch a provenance SC: STORE batch, signer proofs&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;not filled yet — greenfield&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1360" y="430" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd5" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345" y="415" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c6" value="&lt;b&gt;💬 Censorship-proof social&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;🟡 PARTIAL — BUILD ON IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Platforms deplatform; posts vanish&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; TELA hosting (no server) + DEchan boards + Hologram&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Open DEchan; publish your own TELA page&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DEchan (Skyclad0bserver) · Hologram (DHEBP)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd6" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="715" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c7" value="&lt;b&gt;🤖 Machine-to-machine payments&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;🔴 EXPERIMENTAL — PROTOTYPE IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; No rails for devices paying devices (vending, EV, IoT)&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; 18 s finality, ~2.5 KB txs, dust-friendly&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Wallet RPC in a Pi script — auto-pay per use&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;not filled yet — greenfield&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="700" y="730" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd7" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685" y="715" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c8" value="&lt;b&gt;🎓 Verifiable credentials&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;🟡 PARTIAL — BUILD ON IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Diplomas and IDs are forged; verification is slow&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; DeroAuth + Name Service + signed claims on-chain&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Sign a credential claim; verify with DeroAuth&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DeroAuth (DHEBP) · Name Service (DVM)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1360" y="730" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd8" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345" y="715" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c9" value="&lt;b&gt;💸 Private remittances&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#F9A825&quot;&gt;&lt;b&gt;🟡 PARTIAL — BUILD ON IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Cross-border costs 5–10% and can be frozen&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; Private ~1-min transfers, near-zero fees&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Send DERO wallet-to-wallet — no bank in the middle&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;core DHEBP transfers (live since 2017)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd9" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="1015" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c10" value="&lt;b&gt;🛡️ Parametric insurance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;🔴 EXPERIMENTAL — PROTOTYPE IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Claims need adjusters; payouts are slow and disputed&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; DVM pays out by code when conditions are met (oracle)&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Model a flight-delay SC with an oracle entrypoint&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;&lt;i&gt;not filled yet — greenfield&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="700" y="1030" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd10" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685" y="1015" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-c11" value="&lt;b&gt;🎮 Play-to-earn, hidden inventories&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;🔴 EXPERIMENTAL — PROTOTYPE IT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;PROBLEM:&lt;/font&gt; Game economies leak: exploits, sniping, bots&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;DERO:&lt;/font&gt; Encrypted game state — items &amp; balances private&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;TRY:&lt;/font&gt; Extend Dero-Baccarat with a private item registry&lt;br&gt;&lt;font color=&quot;#5A6B7A&quot;&gt;FILLED BY:&lt;/font&gt; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;dreamtables (partial — no hidden inventory yet)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=12;fontSize=10.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="1360" y="1030" width="640" height="280" as="geometry"/></mxCell><mxCell id="x-bd11" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345" y="1015" width="30" height="30" as="geometry"/></mxCell><mxCell id="x-f" value="Nothing here is a product claim — statuses are best-effort reads of what exists in the repos vs what is still an idea.  The point of this page is to give experiments a starting line." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#5A6B7A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1840" height="56" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="ramp" name="Run Your Own Experiment">
<mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="draft" value="&#9888;&#65039; DRAFT &#8212; community draft — not verified, reviewed, or audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="976" width="380" height="34" as="geometry"/></mxCell><mxCell id="r-t1" value="RUN YOUR OWN EXPERIMENT — FIVE STEPS FROM IDEA TO ON-CHAIN" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1880" height="40" as="geometry"/></mxCell><mxCell id="r-t2" value="The fastest path from ‘what if’ to a working contract. No funding, no permission, no trust required." style="text;html=1;align=center;fontSize=13.5;fontColor=#5A6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1880" height="22" as="geometry"/></mxCell><mxCell id="r-s0" value="&lt;font color=&quot;#1E88E5&quot;&gt;&lt;b&gt;STEP 1 · PICK A USE CASE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;From page 1 — or your own pain point. Write one sentence: ‘I want X to happen without Y.’" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=14;fontSize=12.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="1560" height="88" as="geometry"/></mxCell><mxCell id="r-bd0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E88E5;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="r-s1" value="&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;STEP 2 · MAP IT TO PRIMITIVES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Money = DHEBP · Logic = DVM · State = GravitonDB · UI = TELA · Wallet = XSWD · Funding = EPOCH · Identity = DeroAuth/Name Service · Privacy = zero-knowledge proofs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=14;fontSize=12.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="1560" height="88" as="geometry"/></mxCell><mxCell id="r-bd1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#00838F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="215" width="30" height="30" as="geometry"/></mxCell><mxCell id="r-s2" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;STEP 3 · RUN THE SIMULATOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;derod --simulator spins up a local chain with pre-funded wallets — no risk, no cost, instant feedback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=14;fontSize=12.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="1560" height="88" as="geometry"/></mxCell><mxCell id="r-bd2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="315" width="30" height="30" as="geometry"/></mxCell><mxCell id="r-s3" value="&lt;font color=&quot;#FB8C00&quot;&gt;&lt;b&gt;STEP 4 · START FROM EXISTING CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fork lottery.bas, Dero-Baccarat, the marketplace SC, DeroBeats, or a dSlate template — don’t start from zero." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=14;fontSize=12.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="1560" height="88" as="geometry"/></mxCell><mxCell id="r-bd3" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FB8C00;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="415" width="30" height="30" as="geometry"/></mxCell><mxCell id="r-s4" value="&lt;font color=&quot;#8E24AA&quot;&gt;&lt;b&gt;STEP 5 · DEPLOY &amp; SHIP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Testnet first (install_sc → SCID), then mainnet. Wire XSWD permissions (ask / accept_always / deny_always) and serve on TELA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;verticalAlign=top;align=left;spacing=10;spacingTop=14;fontSize=12.5;fontColor=#22303C;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="1560" height="88" as="geometry"/></mxCell><mxCell id="r-bd4" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8E24AA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="515" width="30" height="30" as="geometry"/></mxCell><mxCell id="r-h" value="WHEN TO REACH FOR WHICH PRIMITIVE" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#4277BB;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="600" height="26" as="geometry"/></mxCell><mxCell id="r-p0" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;DHEBP · L1&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— money &amp; settlement&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;private payments, escrow, remittances&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="664" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p1" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;DVM + DeroScript&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— logic&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;lotteries, loans, insurance, DAOs, markets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="664" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p2" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;GravitonDB&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— encrypted state&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;registries, inventories, credentials, votes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="738" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p3" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;TELA&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— front-end&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;storefronts, dashboards, uncensorable sites&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="738" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p4" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;XSWD&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— wallet bridge&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;sign-in, pay, approve every dApp action&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="812" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p5" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;EPOCH&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— funding&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;crowd mining — usage pays for the app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="812" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p6" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;Name Service&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— identity&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;human-readable addresses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="886" width="900" height="64" as="geometry"/></mxCell><mxCell id="r-p7" value="&lt;font color=&quot;#4277BB&quot;&gt;&lt;b&gt;ZK proofs&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5A6B7A&quot;&gt;— privacy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#66727E&quot;&gt;prove without revealing — balance, age, origin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#4277BB;strokeWidth=1.5;fontSize=12;fontColor=#22303C;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="886" width="900" height="64" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
